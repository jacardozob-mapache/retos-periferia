# Variables de entorno del reto (docs/ARQUITECTURA.md §7).
#
# Uso local:  cp .env.example .env   y completa los valores marcados como
# OBLIGATORIA. Bun carga .env automáticamente al ejecutar `bun run dev`.
# .env está en .gitignore: nunca lo subas al repositorio ni lo compartas.
# En Fly.io las no secretas viven en fly.toml [env] y las secretas se cargan
# con `flyctl secrets` desde los secretos de GitHub (docs/DESPLIEGUE.md).

# ─── Servidor ────────────────────────────────────────────────────────────────

# Puerto HTTP del backend (sirve también el front del chat y el panel /admin).
PORT=3000

# Carpeta de datos persistentes: sesiones, workspaces por sesión y uso.jsonl.
# En local basta ./data (ignorada por git); en Fly.io es el volumen /data.
DATA_DIR=./data

# ─── Acceso ──────────────────────────────────────────────────────────────────

# OBLIGATORIA. Llave que el evaluador escribe en la pantalla de ingreso del
# link (header x-access-key). Genérala con:  openssl rand -base64 24
ACCESS_KEY=

# OBLIGATORIA. Llave del panel /admin y de /api/admin/* (header x-admin-key).
# Debe ser distinta de ACCESS_KEY. Genérala con:  openssl rand -base64 32
ADMIN_KEY=

# OBLIGATORIA. Sal para el hash del visitante (IP + user agent) en el registro
# de uso; así no se guarda la IP completa. Genérala con:  openssl rand -hex 32
IP_HASH_SALT=

# ─── Modelo principal ────────────────────────────────────────────────────────

# Proveedor: gemini | groq | openai-compatible | anthropic | guionado
LLM_PROVIDER=gemini

# Modelo del proveedor principal.
LLM_MODEL=gemini-3.5-flash-lite

# OBLIGATORIA (salvo LLM_PROVIDER=guionado). Clave del proveedor principal.
# Gemini, capa gratuita: Google AI Studio → https://aistudio.google.com/apikey
# (inicia sesión con una cuenta de Google → "Create API key").
LLM_API_KEY=

# Solo para LLM_PROVIDER=openai-compatible (OpenRouter, Mistral, Cerebras,
# Ollama, LM Studio…): URL base del endpoint compatible con OpenAI.
# Para gemini y groq el núcleo ya conoce la URL; déjala comentada.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ─── Modelo de respaldo (si el principal responde 429, 5xx o timeout) ────────

# Proveedor de respaldo. Si no vas a usar respaldo, comenta las tres
# variables LLM_FALLBACK_*.
LLM_FALLBACK_PROVIDER=groq

# Modelo del proveedor de respaldo.
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# Recomendada. Clave del respaldo.
# Groq, capa gratuita: https://console.groq.com/keys (inicia sesión → "Create API Key").
LLM_FALLBACK_API_KEY=

# ─── Límites de costo y robustez ─────────────────────────────────────────────

# Tiempo máximo de espera por llamada al proveedor LLM, en milisegundos.
LLM_TIMEOUT_MS=30000

# Tope de iteraciones (llamadas al modelo) por turno del agente.
MAX_ITERACIONES=25

# Tope de tokens (entrada + salida) por sesión.
MAX_TOKENS_SESION=400000

# Tope de mensajes del usuario por sesión.
MAX_MENSAJES_SESION=60

# Tope de sesiones nuevas por día en todo el servidor.
MAX_SESIONES_DIA=200

# ─── Opcional ────────────────────────────────────────────────────────────────

# Fecha de referencia fija (YYYY-MM-DD) para reproducir resultados. Si no se
# define, se usa la fecha actual en America/Bogota.
# FECHA_REFERENCIA=2026-09-26
