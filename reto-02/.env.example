# Variables de entorno del reto (docs/ARQUITECTURA.md §7).
#
# Uso local:  cp .env.example .env   y completa los valores marcados como
# OBLIGATORIA. Bun carga .env automáticamente al ejecutar `bun run dev`.
# .env está en .gitignore: nunca lo subas al repositorio ni lo compartas.
# En Vercel se definen en Settings → Environment Variables de cada proyecto
# (paso a paso en docs/DESPLIEGUE.md del monorepo).

# ─── Servidor ────────────────────────────────────────────────────────────────

# Puerto HTTP del backend en local y en Docker (sirve también el front del chat
# y el panel /admin). En Vercel no aplica: la plataforma asigna el endpoint.
PORT=3000

# Carpeta de trabajo: workspaces aislados por sesión (out/ de cada sesión) y,
# con ALMACEN=archivo, también sesiones y registro de uso (uso.jsonl).
# En local basta ./data (ignorada por git). En Docker es /data. En Vercel el
# único sistema de archivos escribible es /tmp: usa DATA_DIR=/tmp/perxia.
DATA_DIR=./data

# ─── Almacenamiento de sesiones y registro de uso ───────────────────────────

# archivo: todo en DATA_DIR (local y Docker; un solo servidor).
# upstash: Upstash Redis por REST (obligatorio en Vercel, donde cada instancia
#          de la función tiene su propio /tmp efímero).
ALMACEN=archivo

# Solo con ALMACEN=upstash. URL y token REST de la base de Upstash Redis
# (consola de Upstash → la base → pestaña REST API).
# La integración de Upstash del Marketplace de Vercel inyecta estas mismas
# credenciales como KV_REST_API_URL y KV_REST_API_TOKEN; el servidor también
# las acepta con esos nombres, así que en Vercel no hace falta copiarlas.
# UPSTASH_REDIS_REST_URL=https://<tu-base>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# ─── Acceso ──────────────────────────────────────────────────────────────────

# OBLIGATORIA. Llave que el evaluador escribe en la pantalla de ingreso del
# link (header x-access-key). Genérala con:  openssl rand -base64 24
ACCESS_KEY=

# OBLIGATORIA. Llave del panel /admin y de /api/admin/* (header x-admin-key).
# Debe ser distinta de ACCESS_KEY. Genérala con:  openssl rand -base64 32
ADMIN_KEY=

# OBLIGATORIA. Sal para el hash del visitante (IP + user agent) en el registro
# de uso; así no se guarda la IP completa. Genérala con:  openssl rand -hex 32
IP_HASH_SALT=

# ─── Modelo (Gemini, capa gratuita) ──────────────────────────────────────────

# Proveedor principal: gemini | openai-compatible | anthropic | guionado
LLM_PROVIDER=gemini

# Modelo principal.
LLM_MODEL=gemini-3.8-flash

# OBLIGATORIA (salvo LLM_PROVIDER=guionado). Clave de Gemini, gratis en Google
# AI Studio → https://aistudio.google.com/apikey (inicia sesión con una cuenta
# de Google → "Create API key"). Es la única clave que necesita el reto.
LLM_API_KEY=

# Solo para LLM_PROVIDER=openai-compatible (OpenRouter, Mistral, Cerebras,
# Ollama, LM Studio…): URL base del endpoint compatible con OpenAI.
# Para gemini el núcleo ya conoce la URL; déjala comentada.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ─── Respaldo (si el principal responde 429, 5xx o timeout) ─────────────────

# Otro modelo de Gemini con la misma clave: la cuota gratuita de Gemini se
# cuenta por modelo, así que el respaldo tiene su propio cupo.
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Solo si el respaldo usa un proveedor distinto del principal; si se omite, el
# respaldo usa LLM_API_KEY.
# LLM_FALLBACK_API_KEY=

# ─── Límites de costo y robustez ─────────────────────────────────────────────

# Tiempo máximo de espera por llamada al proveedor LLM, en milisegundos.
LLM_TIMEOUT_MS=30000

# Tope de iteraciones (llamadas al modelo) por turno del agente.
MAX_ITERACIONES=25

# Tope de tokens (entrada + salida) por sesión.
MAX_TOKENS_SESION=400000

# Tope de mensajes del usuario por sesión.
MAX_MENSAJES_SESION=60

# Tope de sesiones nuevas por día en todo el servidor.
MAX_SESIONES_DIA=200

# ─── Opcional ────────────────────────────────────────────────────────────────

# Fecha de referencia fija (YYYY-MM-DD) para reproducir resultados. Si no se
# define, se usa la fecha actual en America/Bogota.
# FECHA_REFERENCIA=2026-09-26
